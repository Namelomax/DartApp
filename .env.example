# Copy this file to `.env` and fill in the values.
# Leave AI_API_KEY empty to play on the downloaded noun dictionary only.

# Base URL of an OpenAI-compatible API, WITHOUT the /chat/completions suffix.
AI_BASE_URL=https://openrouter.ai/api/v1

# Model id as the provider spells it.
AI_MODEL=google/gemini-2.5-flash

# Your API key. See the security note in README before shipping a web build.
AI_API_KEY=

# How many words to ask for per round. Words the noun dictionary can't confirm
# are discarded, so ask for more than you need.
AI_WORD_COUNT=60
